<Project>

  <!-- The WebView2 package ships WinForms and WPF hosts side by side. We only use the
       WinForms one; leaving the WPF assembly in the reference set drags in a second
       WindowsBase and every build prints MSB3277. Drop it before references resolve. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <!-- A self-contained publish copies the whole Windows Desktop runtime, and that is WinForms
       and WPF together whichever one the project switched on. EmailLock never loads WPF, so
       leave it out: about 50 MB of the install. The names are the assemblies marked
       Profile="WPF" in the SDK's own FrameworkList.xml, the WPF-only ones that list leaves
       out, and the native libraries only they load. Dropping them here, before the publish
       list and EmailLock.deps.json are built, keeps the two in step. -->
  <Target Name="DropWpfRuntime" AfterTargets="ResolveRuntimePackAssets">
    <ItemGroup>
      <_WpfOnly Include="@(RuntimePackAsset)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^(Presentation|ReachFramework|System\.Printing|System\.Windows\.Controls\.Ribbon|System\.Windows\.Input\.Manipulations|System\.Windows\.Presentation|System\.Xaml|UIAutomation|WindowsBase|WindowsFormsIntegration|DirectWriteForwarder|D3DCompiler_47_cor3|PenImc_cor3|wpfgfx_cor3)'))" />
      <RuntimePackAsset Remove="@(_WpfOnly)" />
      <ReferenceCopyLocalPaths Remove="@(_WpfOnly)" />
    </ItemGroup>
  </Target>

</Project>
